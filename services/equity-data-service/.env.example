# Render and other hosting platforms normally supply PORT automatically.
PORT=8081
# Comma-separated allowlist of browser origins permitted by CORS.
ALLOWED_ORIGINS=https://teknoify.com,https://www.teknoify.com
# Interval in seconds between cached background collection runs.
EQUITY_REFRESH_SECONDS=900
# Delay in seconds used to pace sequential Yahoo requests.
YF_REQUEST_DELAY_SECONDS=2.0
